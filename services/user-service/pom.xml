<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.devsecops</groupId>
    <artifactId>user-service</artifactId>
    <version>1.0.0</version>
    <name>user-service</name>
    <description>User microservice: manages end users</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Pinned ahead of the Spring Boot BOM. 4.1.1 manages Tomcat
             11.0.24, and the "Image" job in .github/workflows/security.yml
             fails on the HIGH Tomcat CVEs that 11.0.25 fixes. -->
        <tomcat.version>11.0.26</tomcat.version>
        <!-- Phase 7. The NVD API is rate-limited without a key, so the
             "Dependencies" job in .github/workflows/security.yml passes this
             in with -Dnvd.api.key=${{ secrets.NVD_API_KEY }} when the secret
             exists. It stays empty here (an empty key means "no key") so a
             local run needs no secret and no extra arguments. -->
        <nvd.api.key></nvd.api.key>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Spring Boot 4 split the web test support out of
            spring-boot-starter-test: @AutoConfigureMockMvc and @WebMvcTest now
            live in spring-boot-webmvc-test, and TestRestTemplate in
            spring-boot-resttestclient. This starter aggregates all three, so
            the tests below compile without another dependency.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Mockito 5's inline mock maker has to be loaded as a JVM
                        agent. Without this it falls back to self-attaching at
                        runtime, which fails wherever the JVM will not let a
                        process attach to itself ("Could not self-attach to
                        current VM using external process"), and the failure
                        looks like every @Mock test erroring at once rather
                        than like a configuration problem. mockito-core ships
                        Premain-Class: org.mockito.internal.PremainAttach
                        precisely so it can be used here.
                    -->
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
            <!--
                Phase 7. Declared but deliberately not bound to a lifecycle
                phase: "mvn verify" stays as fast as it was in Phase 2, and the
                scan runs where it belongs - the "Dependencies" job in
                .github/workflows/security.yml, which is also the only place
                that can cache the NVD database between runs.

                Run it by hand with:
                    mvn -B -ntp dependency-check:check
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.1.3</version>
                <configuration>
                    <!-- Fail on HIGH and above. Trivy's HIGH/CRITICAL exit code
                         is the pipeline gate; this scan is the per-dependency
                         detail behind a finding. -->
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- Outside target/ so the security workflow can cache the
                         NVD database between runs rather than re-download it
                         once per service. -->
                    <dataDirectory>${user.home}/.dependency-check-data</dataDirectory>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
