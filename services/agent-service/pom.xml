<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.devsecops</groupId>
    <artifactId>agent-service</artifactId>
    <version>1.0.0</version>
    <name>agent-service</name>
    <description>DevOps Assistant Agent: diagnoses CI failures and proposes a fix</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Pinned ahead of the Spring Boot BOM. 4.1.1 manages Tomcat
             11.0.24, and the "Image" job in .github/workflows/security.yml
             fails on the HIGH Tomcat CVEs that 11.0.25 fixes. -->
        <tomcat.version>11.0.26</tomcat.version>
        <!-- Same reason as Tomcat, one line up: 4.1.1 manages Jackson 3.1.5,
             and the "Image" job reports five HIGH CVEs against it. 3.1.8 is
             the newest release on the 3.1 line, and that line is the ceiling:
             3.2.x does not run here. Its jackson-databind asks for
             com.fasterxml.jackson.annotation.JsonApplyView, an annotation the
             jackson-annotations 2.x artifact - the only annotations artifact
             there is, and the one Boot 4.1.1 manages - does not have, so the
             first serialized response dies with NoClassDefFoundError. 3.1.8
             meets every fix version Trivy names for four of the five; the
             fifth is the one entry .trivyignore.yaml records, and why. -->
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <!-- Phase 7. Empty means "no key": the "Dependencies" job in
             .github/workflows/security.yml passes the real one in with
             -Dnvd.api.key when the repository secret exists, so a local run
             needs no secret and no extra arguments. -->
        <nvd.api.key></nvd.api.key>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Deliberately no Spring AI / LangChain4j, and no JPA or H2.

            The agent has exactly one LLM call to make - a single POST to
            Ollama's /api/chat - and it talks to it with the JDK's HttpClient
            (see OllamaDiagnosisEngine). That keeps the agent on the same Spring
            Boot version as the three services, keeps the image small, and means
            the only moving part between this code and the model is an HTTP
            request that a test can stand in front of. It is also why the agent
            is stateless: Phase 8 keeps its run history in the log, not in a
            database.
        -->
        <!--
            Spring Boot 4 split the web test support out of
            spring-boot-starter-test: @AutoConfigureMockMvc and @WebMvcTest now
            live in spring-boot-webmvc-test, and TestRestTemplate in
            spring-boot-resttestclient. This starter aggregates all three, so
            the tests below compile without another dependency.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Mockito 5's inline mock maker has to be loaded as a JVM
                        agent. Without this it falls back to self-attaching at
                        runtime, which fails wherever the JVM will not let a
                        process attach to itself ("Could not self-attach to
                        current VM using external process"), and the failure
                        looks like every @Mock test erroring at once rather
                        than like a configuration problem. mockito-core ships
                        Premain-Class: org.mockito.internal.PremainAttach
                        precisely so it can be used here.
                    -->
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
            <!--
                Phase 7. Declared but not bound to a lifecycle phase, so
                "mvn verify" stays fast and the scan runs in the "Dependencies"
                job of .github/workflows/security.yml - the only place that can
                cache the NVD database between runs.

                Run it by hand with:
                    mvn -B -ntp dependency-check:check
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.1.3</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <dataDirectory>${user.home}/.dependency-check-data</dataDirectory>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                    <!-- The Sonatype OSS Index analyzer is on by default, and
                         the API it calls now answers 401: the free
                         component-report endpoint it depends on has been
                         retired. Every dependency therefore raised an
                         AnalysisException, and the job failed on ~40 of them
                         before it had looked at a single finding. The NVD feed
                         is the analyzer this scan is for. -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
